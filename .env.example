# ==============================================================================
# BYTEACADEMY ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================
# IMPORTANT SECURITY DIRECTIVE:
# Do NOT store private API keys (such as GEMINI_API_KEY) in VITE_ variables!
# Any variable starting with VITE_ is bundled directly into the client JavaScript
# and exposed publicly to browser devtools.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Client / Vite)
# ------------------------------------------------------------------------------
# EmailJS configuration for contact form submissions.
# On Vercel: Set these under Project Settings -> Environment Variables.

VITE_EMAIL_SERVICE_ID=""
VITE_EMAIL_TEMPLATE_ID=""
VITE_EMAIL_PUBLIC_KEY=""

# Legacy alias compatibility (optional):
# VITE_EMAILJS_SERVICE_ID=""
# VITE_EMAILJS_TEMPLATE_ID=""
# VITE_EMAILJS_PUBLIC_KEY=""

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Server / Vercel Serverless Functions)
# ------------------------------------------------------------------------------
# Private server-side secrets. Never prefix with VITE_.
# On Vercel: Set GEMINI_API_KEY under Environment Variables (available to Serverless Functions).

GEMINI_API_KEY=""

# ==============================================================================
